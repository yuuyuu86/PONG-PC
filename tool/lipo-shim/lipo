#!/bin/sh
# Xcode 27 の lipo は「lipo <file> -verify_arch arm64 x86_64」のように複数のアーキテクチャを
# まとめて確かめると失敗する（"-verify_arch requires exactly one input file"）。
# Flutter の macOS ビルドはこの形で呼ぶので、1つずつ確かめる形に分けてから本物の lipo に渡す。
# それ以外の呼び出しはそのまま /usr/bin/lipo へ。
if [ "$#" -ge 4 ] && [ "$2" = "-verify_arch" ]; then
  file="$1"
  shift 2
  for arch in "$@"; do
    /usr/bin/lipo "$file" -verify_arch "$arch" || exit 1
  done
  exit 0
fi
exec /usr/bin/lipo "$@"
